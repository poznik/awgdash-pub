# awgdash — шаблон переменных окружения (копировать в /etc/awgdash/awgdash.env, chmod 0600)
# Секретов здесь нет; значения ниже — примеры.

AWGDASH_MODE=hub                     # hub | node  (hub — он же локальный узел)
AWGDASH_LISTEN=127.0.0.1:10088        # только loopback; наружу — через обратный прокси
AWGDASH_DB=/var/lib/awgdash/awgdash.db
AWGDASH_DATA_DIR=/var/lib/awgdash
AWGDASH_AWG_CONF_DIR=/etc/amnezia/amneziawg

AWGDASH_ADMIN_HOST=admin.example.com  # админка отвечает только на этом Host (плюс localhost для туннеля)
# Вход в админку живёт в БД, а не здесь: `awgdash admin create <имя>` заводит администратора,
# `awgdash admin passwd <имя>` меняет пароль, `awgdash admin totp <имя>` готовит второй фактор.
AWGDASH_PORTAL_HOST=my.example.com    # портал пользователей — только на этом Host (M4)
AWGDASH_TZ=UTC
AWGDASH_5M_RETENTION=336h            # 14 дней: сутки рисуются по сырым записям, неделя и месяц — по часовым
AWGDASH_JOURNAL_RETENTION=4320h      # 180 дней: столько живут записи аудита и события (страница показывает 90)
AWGDASH_FORWARDED_HOPS=1             # сколько обратных прокси перед панелью; адрес клиента берётся с хвоста X-Forwarded-For, 0 — заголовок не разбирать

AWGDASH_SESSION_KEY=                  # 32+ случайных байта base64 (openssl rand -base64 32)
AWGDASH_NODE_TOKEN=                   # bearer-токен API узла (тот же на хабе и узле)
AWGDASH_FOREIGN_MANAGERS=wg-dashboard.service  # чужие менеджеры пиров: юнит или docker:<контейнер>, через запятую

AWGDASH_TELEGRAM_TOKEN=               # токен бота из BotFather
AWGDASH_TELEGRAM_ADMIN_IDS=           # числовые user id через запятую — whitelist

AWGDASH_AGE_RECIPIENT=                # публичный ключ age (age1…) для шифрования копий; создаётся `awgdash backup keygen --install`
AWGDASH_ENV_FILE=/etc/awgdash/awgdash.env  # какой файл класть в копию (он же переписывается при restore)
AWGDASH_BACKUP_SCP_TARGET=            # необязательно: user@host:/path для копии full-бэкапа
